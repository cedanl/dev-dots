
# =====================
# Entire - auto-enable per CEDA repo
# =====================
# CEDA-repo's: de GitHub-org cedanl en de GitLab-groep surf-internal/npuls/ceda (herkenning aan de origin-URL).
# Checkpoints gaan voor beide naar dezelfde privé GitHub-repo: Entire kent als checkpoint-remote alleen `github`.
#
# Privacy: Entire bewaart sessietranscripten (prompts, tool-output, antwoorden) in die repo, die gevoelige
# data kan bevatten. Daarom: eenmalige melding per repo, en opt-out via
#   export DEVDOTS_ENTIRE=0            (alle repo's, bijv. in ~/.bashrc of remoteEnv)
#   git config devdots.entire false    (alleen deze repo)
_entire_auto_enable() {
  local agent="$1" origin notice
  [[ "${DEVDOTS_ENTIRE:-1}" == "0" ]] && return 0
  git rev-parse --is-inside-work-tree &>/dev/null || return 0
  [[ "$(git config --get devdots.entire 2>/dev/null)" == "false" ]] && return 0
  origin=$(git remote get-url origin 2>/dev/null || true)
  case "$origin" in
    *cedanl/* | *surf-internal/npuls/ceda/*)
      notice=$(git rev-parse --git-path devdots-entire-notified 2>/dev/null) || notice=""
      if [[ -n "$notice" && ! -e "$notice" ]]; then
        {
          echo "┌─ Entire staat aan voor deze repo ───────────────────────────────────"
          echo "│ Sessietranscripten (prompts, tool-output en antwoorden) worden bewaard"
          echo "│ in github:cedanl/entire-checkpoints. Zet geen geheimen of persoonsgegevens"
          echo "│ in een sessie als je dat niet wilt delen."
          echo "│ Uitzetten: git config devdots.entire false   (deze repo)"
          echo "│            export DEVDOTS_ENTIRE=0           (alle repo's)"
          echo "└──────────────────────────────────────────────────────────────────────"
        } >&2
        : >"$notice" 2>/dev/null || true
      fi
      entire enable -y --agent "$agent" &>/dev/null || true
      entire configure --checkpoint-remote github:cedanl/entire-checkpoints &>/dev/null || true
      _entire_keep_local
      ;;
  esac
}

# Houdt wat Entire toevoegt lokaal: `entire enable` schrijft zijn hooks in .claude/settings.json, een bestand dat
# repo's vaak in git hebben (en dat een publieke spiegel meeneemt). entire-local-hooks.py zet ze in
# .claude/settings.local.json en herstelt settings.json; .entire/ en het lokale bestand gaan in info/exclude.
_entire_keep_local() {
  local exclude pattern
  exclude=$(git rev-parse --git-path info/exclude 2>/dev/null) || return 0
  mkdir -p "$(dirname "$exclude")"
  for pattern in "/.entire/" "/.claude/settings.local.json"; do
    grep -qxF "$pattern" "$exclude" 2>/dev/null || echo "$pattern" >>"$exclude"
  done
  (cd "$(git rev-parse --show-toplevel)" && python3 "$HOME/.config/bash/entire-local-hooks.py") || true
}

# =====================
# Claude Code - auto-enable Entire per repo
# =====================
claude() {
  _entire_auto_enable claude-code
  command claude --dangerously-skip-permissions "$@"
}

# =====================
# Onboarding Wizard
# =====================
onboard() {
  # Run the wizard script to set up authentication and configuration.
  local script="$HOME/.onboard.sh"
  if [[ ! -f "$script" ]]; then
    echo "[onboard] Wizard script not found at $script" >&2
    return 1
  fi
  bash "$script" "$@"
}

# =====================
# Compression & Archiving
# =====================
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }

# =====================
# CSV Exploration Helper
# =====================
csvlens() {
  if [ "$#" -eq 0 ]; then
    local file
    file=$(fdfind . . --type f --extension csv | fzf --prompt='CSV file> ')
    [ -n "$file" ] && command csvlens "$file"
  else
    command csvlens "$@"
  fi
}
# Usage: csvlens (fuzzy-pick CSV), csvlens file.csv (direct open)

# =====================
# Shell & History Utilities
# =====================
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}
__fzf_history__() {
  local selected
  selected=$(history | awk '{sub(/^[ \t]*[0-9]+[ \t]*/, ""); if (!seen[$0]++) print}' | fzf --tac --preview 'echo {}' | sed 's/ *[0-9]* *//')
  if [ -n "$selected" ]; then
    READLINE_LINE="$selected"
    READLINE_POINT=${#READLINE_LINE}
  fi
}
bind -x '"\C-r": __fzf_history__'
# =====================
# GitHub Clone Helper
# =====================
gclone() {
  local owner repo
  owner="${1:-$GITHUB_USER}"   # optional: pass user/org; default: your login

  if [ -z "$owner" ]; then
    owner="$(gh api user --jq '.login')" || return 1
  fi

  repo="$(
    gh repo list "$owner" \
      --limit 1000 \
      --json nameWithOwner,description \
      --jq '.[] | "\(.nameWithOwner)\t\(.description // "")"' |
    fzf --prompt="Select repo to clone: " \
        --with-nth=1,2 \
        --delimiter='\t' \
        --ansi |
    cut -f1
  )" || return 1

  [ -z "$repo" ] && echo "No repo selected" && return 1

  gh repo clone "$repo"

  local dir="${repo##*/}"
  cd "$dir" 2>/dev/null || true
}

